---
// Lesson complete: the trophy, the two tiles, the course count rolling from
// 6 / 12 to 7 / 12 as its bar travels, then the recap and Next lesson. Plays once in view; the poster is the finished screen.
// Real strings: the done screen's labels, the lesson title, the recap.
import BrowserWindow from './BrowserWindow.astro'
import P from './ProductIcon.astro'
---
<div class="well done-well">
  <div class="ss-stage cfl done-stage" id="done-demo" role="img" aria-label="The lesson-complete screen for 'The orders handler': 75% first try and the course moving from 6 to 7 of 12 lessons, with a recap and a Next lesson button.">
    <BrowserWindow url="orders-api/index.html" class="done-win">
      <div class="topbar">
        <div class="logo">Orders API <span>course</span></div>
      </div>
      <div class="done">
        <div class="trophy"><P name="trophy" /></div>
        <div class="titles">
          <div class="h">Lesson complete</div>
          <p>The orders handler</p>
        </div>
        <div class="tiles">
          <div class="tile"><small>First try</small><b>75%</b></div>
          <div class="tile t-course"><small>Course</small><b><span class="roll r-course"><span><span>6</span><span>7</span></span></span> / 12</b><div class="progress"><span></span></div></div>
        </div>
        <div class="recap"><b>Remember</b>The handler checks the body, calls <code>createOrder</code>, and answers <code>201</code> with the new order.</div>
        <span class="btn next">Next lesson</span>
      </div>
    </BrowserWindow>
  </div>
</div>

<style is:global>
  .done-well { height: 580px; }
  .done-stage { position: absolute; inset: 0; overflow: hidden; }
  .done-stage .done-win { position: absolute; left: 48px; right: 48px; top: 48px; height: 600px; }
  .done-stage .topbar {
    display: flex; align-items: center; gap: 8px; height: 52px; padding: 0 20px; border-bottom: 1px solid var(--border);
  }
  .done-stage .logo { flex: 1; min-width: 0; font-weight: 600; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .done-stage .logo span { color: var(--muted-foreground); }

  .done-stage .done { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 28px 24px; }
  .done-stage .trophy {
    display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; margin-bottom: 14px;
    background: var(--muted); border: 1px solid var(--border); color: var(--warn);
    transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.3s;
  }
  .done-stage .trophy svg { width: 30px; height: 30px; }
  .done-stage .h { font-size: 24px; font-weight: 600; letter-spacing: -0.015em; }
  .done-stage .titles p { margin: 2px 0 20px; color: var(--muted-foreground); }
  .done-stage .tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; width: 100%; max-width: 440px; margin-bottom: 12px; }
  .done-stage .tile { padding: 10px 8px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); }
  .done-stage .tile small { display: block; font-size: 12px; color: var(--muted-foreground); }
  .done-stage .tile b { display: block; font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 30px; height: 30px; }

  .done-stage .tile .progress { height: 6px; margin: 8px 4px 2px; }
  .done-stage .tile .progress > span { width: 50%; transition: width 0.6s cubic-bezier(0.45, 0, 0.1, 1); }
  .done-stage .t-course.is-up .progress > span { width: 58.33%; }
  .done-stage .recap { width: 100%; max-width: 440px; text-align: left; border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 16px; margin: 4px 0 18px; font-size: 14.5px; background: var(--card); }
  .done-stage .recap b { display: block; margin-bottom: 2px; font-weight: 600; }
  .done-stage .next { width: 100%; max-width: 440px; height: 40px; }

  /* Arrival: each group rises in place; nothing moves its neighbours */
  .done-stage .titles, .done-stage .tile, .done-stage .recap, .done-stage .next { will-change: transform; transition: opacity 0.35s, transform 0.45s cubic-bezier(0.25, 0.8, 0.25, 1); }
  .done-stage .tile:nth-child(2) { transition-delay: 0.08s; }
  .done-stage .next { transition-delay: 0.1s; }
  .done-stage:not([data-step]) .trophy, .done-stage[data-step='0'] .trophy { opacity: 0; transform: scale(0.8); }
  .done-stage .is-hidden { opacity: 0; transform: translateY(8px); }
  .done-stage .roll > span { transform: translateY(calc(var(--i, 0) * -1lh)); }

  @media (max-width: 560px) {
    .done-well { height: 600px; border-radius: 20px; }
    .done-stage .done-win { left: 16px; right: 16px; top: 24px; height: 640px; }
    .done-stage .topbar { padding: 0 14px; }
    .done-stage .done { padding: 28px 16px; }
  }
</style>

<script>
  import { stage } from '../scripts/stage'
  const root = document.getElementById('done-demo')!
  const all = <T extends Element = HTMLElement>(sel: string) => [...root.querySelectorAll<T & HTMLElement>(sel)]
  const setRoll = (sel: string, i: number) => all(sel).forEach((r) => {
    r.style.setProperty('--i', String(i))
    r.querySelectorAll(':scope > span > span').forEach((d, k) => d.classList.toggle('is-on', k === i))
  })
  stage(root, {
    initial: { step: 0, up: null },
    poster: { step: 3, up: true },
    render(_, d) {
      const step = Number(d.step ?? 3)
      const up = d.up !== undefined
      all('.titles, .tile').forEach((el) => el.classList.toggle('is-hidden', step < 2))
      all('.recap, .next').forEach((el) => el.classList.toggle('is-hidden', step < 3))
      setRoll('.r-course', up ? 1 : 0)
      root.querySelector('.t-course')!.classList.toggle('is-up', up)
    },
    async script(a) {
      await a.wait(500)
      a.mark('trophy')
      a.set({ step: 1 })
      await a.wait(450)
      a.mark('tiles')
      a.set({ step: 2 })
      await a.wait(1100)
      a.mark('course')
      a.set({ up: true })
      await a.wait(1300)
      a.mark('recap')
      a.set({ step: 3 })
      await a.wait(1200)
    },
  })
</script>
