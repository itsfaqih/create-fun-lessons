---
// Page icons: Phosphor, filled, one size per context. The GitHub mark is the
// real one from Simple Icons.
import copy from '@phosphor-icons/core/assets/fill/copy-fill.svg?raw'
import check from '@phosphor-icons/core/assets/fill/check-fill.svg?raw'
import arrowRight from '@phosphor-icons/core/assets/fill/arrow-right-fill.svg?raw'
import github from 'simple-icons/icons/github.svg?raw'

const icons = { copy, check, 'arrow-right': arrowRight, github } as const
interface Props { name: keyof typeof icons; size?: number; class?: string }
const { name, size = 16, class: cls } = Astro.props
const svg = icons[name]
  .replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" ${cls ? `class="${cls}" ` : ''}`)
  .replace(/<title>.*?<\/title>/, '')
const filled = name === 'github' ? svg.replace('<svg ', '<svg fill="currentColor" ') : svg
---
<Fragment set:html={filled} />
