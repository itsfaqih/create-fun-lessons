---
// Coverage: the checker run with --repo finds a top-level directory the
// syllabus leaves out; a row for it appears in syllabus.md; the second run
// prints OK. Plays once in view; the poster is the green run.
// Real strings: the syllabus header and rows, both check outputs.
import BrowserWindow from './BrowserWindow.astro'
const cmd = 'node check.mjs course.html --repo .'
const rows = [
  ['HTTP routing', ['src/routes/'], 'u2l1, u2l2'],
  ['Orders handlers', ['src/orders/'], 'u2l3, u2l4'],
  ['Generated client', ['gen/client/'], 'skip: generated from api.yaml'],
] as const
---
<div class="well cov-well">
  <div class="ss-stage cfl cov-stage" id="coverage-demo" role="img" aria-label="The checker reports that the scripts directory appears in no Sources cell; a Release scripts row is added to syllabus.md; the checker then prints OK.">
    <BrowserWindow url="syllabus.md" class="cov-win">
      <div class="md">
        <div class="md-h"># Syllabus: Orders API</div>
        <div class="tbl">
          <div class="tr th"><span>Area</span><span>Sources</span><span>Lessons</span></div>
          {rows.map(([area, src, lessons]) => (
            <div class="tr"><span>{area}</span><span>{src.map((s) => <code>{s}</code>)}</span><span class:list={[lessons.startsWith('skip') && 'skip']}>{lessons}</span></div>
          ))}
          <div class="collapse c-row"><div><div class="tr new"><span>Release scripts</span><span><code>scripts/</code></span><span>u5l2</span></div></div></div>
        </div>
      </div>
    </BrowserWindow>
    <div class="term">
      <div class="term-bar"><span class="lights" aria-hidden="true"><i></i><i></i><i></i></span></div>
      <div class="term-body">
        <div class="ln"><span class="p">$</span><span class="typed" data-type="cmd1" style={`--len:${cmd.length}`}>{cmd}</span><span class="caret c1"></span></div>
        <div class="ln outs">
          <div class="out o-bad"><span class="red">1 problem(s):</span><br />- syllabus.md: top-level directory "scripts/" appears in no Sources cell</div>
          <div class="out o-ok"><span class="green">OK: 5 units, 18 lessons, 84 cards, 4 syllabus rows</span></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .cov-well { height: 520px; }
  .cov-stage { position: absolute; inset: 0; overflow: hidden; }
  .cov-stage .cov-win { position: absolute; left: 40px; right: 40px; top: 40px; height: 600px; }
  .cov-stage .md { padding: 20px; }
  .cov-stage .md-h { font: 600 16px 'Geist Mono', monospace; margin-bottom: 14px; }
  .cov-stage .tbl { font-size: 14px; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  .cov-stage .tr { display: grid; grid-template-columns: 0.9fr 0.8fr 1fr; gap: 12px; padding: 10px 14px; border-top: 1px solid var(--border); align-items: center; }
  .cov-stage .tbl > .tr:first-child { border-top: 0; }
  .cov-stage .th { background: var(--muted); font-size: 12.5px; font-weight: 600; color: var(--muted-foreground); }
  .cov-stage .tr > span:first-child { font-weight: 500; }
  .cov-stage .tr > span:nth-child(2) { display: flex; flex-wrap: wrap; gap: 4px; }
  .cov-stage .tr > span:nth-child(3) { font: 13px 'Geist Mono', monospace; }
  .cov-stage .tr code { font-size: 12px !important; }
  .cov-stage .skip { color: var(--muted-foreground); }
  .cov-stage .new { background: var(--ok-soft); box-shadow: inset 3px 0 0 var(--ok); }
  .cov-stage .c-row > div > .tr { border-top: 1px solid var(--border); }

  .cov-stage .term {
    position: absolute; left: 24px; bottom: 24px; width: min(480px, 100% - 48px); z-index: 2;
    background: #141412; color: #e8e4da; border-radius: 12px; box-shadow: var(--shadow-hero), inset 0 0 0 1px rgb(255 255 255 / 8%);
    font: 13px/1.55 'Geist Mono', monospace;
  }
  .cov-stage .term-bar { height: 30px; display: flex; align-items: center; padding: 0 12px; }
  .cov-stage .term-bar .lights { display: flex; gap: 7px; }
  .cov-stage .term-bar i { width: 10px; height: 10px; border-radius: 50%; background: rgb(255 255 255 / 18%); }
  .cov-stage .term-body { padding: 2px 16px 16px; }
  .cov-stage .ln { min-height: 1lh; transition: opacity 0.2s; }
  .cov-stage .ln + .ln { margin-top: 6px; }
  .cov-stage .p { color: rgb(255 255 255 / 45%); margin-right: 1ch; }
  .cov-stage .typed { display: inline-block; vertical-align: top; white-space: nowrap; overflow: hidden; width: calc(var(--n, var(--len)) * 1ch); }
  .cov-stage .caret { display: inline-block; width: 7px; height: 1lh; vertical-align: top; background: rgb(255 255 255 / 70%); opacity: 0; transition: opacity 0.15s; }
  .cov-stage .caret.is-on { opacity: 1; }
  .cov-stage .outs { display: grid; }
  .cov-stage .out { grid-area: 1 / 1; color: rgb(255 255 255 / 70%); transition: opacity 0.25s; }
  .cov-stage .red { color: #ff8a80; }
  .cov-stage .green { color: #7ee2a8; }
  .cov-stage .is-off { opacity: 0; }

  @media (max-width: 560px) {
    .cov-well { height: 560px; border-radius: 20px; }
    .cov-stage .cov-win { left: 16px; right: 16px; top: 16px; }
    .cov-stage .md { padding: 16px; }
    .cov-stage .md-h { font-size: 14px; }
    /* Compact: sources sit under their area; two columns instead of three */
    .cov-stage .tr { grid-template-columns: minmax(0, 1fr) auto; gap: 2px 12px; padding: 10px 12px; font-size: 14px; }
    .cov-stage .tr > span:nth-child(2) { grid-row: 2; grid-column: 1; }
    .cov-stage .tr > span:nth-child(3) { grid-row: 1 / span 2; grid-column: 2; max-width: 9.5em; text-align: right; font-size: 12px; }
    .cov-stage .th > span:nth-child(2) { display: none; }
    .cov-stage .th > span:nth-child(3) { grid-row: 1; }
    .cov-stage .term { left: 16px; bottom: 16px; width: calc(100% - 32px); font-size: 11.5px; }
    .cov-stage .term-body { padding: 2px 14px 14px; }
  }
</style>

<script>
  import { stage } from '../scripts/stage'
  const root = document.getElementById('coverage-demo')!
  const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!
  stage(root, {
    initial: { step: 0 },
    poster: { step: 5 },
    render(_, d) {
      // 0 empty prompt, 1 typing, 2 problem, 3 row added, 4 run again, 5 OK
      const step = Number(d.step ?? 5)
      if (step === 0) $('[data-type="cmd1"]').style.setProperty('--n', '0')
      $('.c1').classList.toggle('is-on', step <= 1 || step === 4)
      $('.o-bad').classList.toggle('is-off', step < 2 || step >= 4)
      $('.c-row').classList.toggle('is-open', step >= 3)
      $('.o-ok').classList.toggle('is-off', step < 5)
    },
    async script(a) {
      await a.wait(700)
      a.mark('type')
      a.set({ step: 1 })
      await a.type('cmd1', 'node check.mjs course.html --repo .', 38)
      await a.wait(350)
      a.mark('problem')
      a.set({ step: 2 })
      await a.wait(1900)
      a.mark('row')
      a.set({ step: 3 })
      await a.wait(1300)
      a.mark('rerun')
      a.set({ step: 4 })
      await a.wait(500)
      a.mark('ok')
      a.set({ step: 5 })
      await a.wait(1200)
    },
  })
</script>
